# Booking system (app/(marketing)/book). All set in Vercel → Project → Settings → Environment Variables.

# Google OAuth client (type: Web application) + a refresh token from scripts/google-oauth.mjs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Calendar to read free/busy from and write events to. Default: primary
GOOGLE_CALENDAR_ID=primary

# Host timezone for availability (IANA name). Default: America/Chicago
BOOKING_TIMEZONE=America/Chicago

# Random secret used to sign cancel links. Generate: openssl rand -hex 32
BOOKING_SECRET=

# Optional branded confirmation email (Google already sends a calendar invite).
RESEND_API_KEY=
BOOKING_FROM_EMAIL=Rubicon <onboarding@resend.dev>
# Owner address added as a guest on each booking, so Google emails you a copy.
# Use an inbox that is NOT the booking calendar's own account (otherwise you're the
# organizer and Google won't email you). Defaults to BRAND.email.
BOOKING_OWNER_EMAIL=

# --- Unsubscribe system (app/(marketing)/unsubscribe + /api/unsubscribe) ---

# Random secret used to sign unsubscribe links. MUST match UNSUB_SECRET in the
# email sender (rubicon-deck-builder) so its tokens verify here. openssl rand -hex 32
UNSUB_SECRET=

# Supabase suppression store. Create a project, run:
#   create table unsubscribes (email text primary key, source text,
#     unsubscribed_at timestamptz default now());
# Use the SERVICE ROLE key (server-side only — never expose to the browser).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Physical mailing address shown in the footer + unsubscribe page (CAN-SPAM requires
# a real postal address; a PO box is fine).
UNSUB_MAILING_ADDRESS=
# Where to email opt-out notifications (fallback if Supabase isn't set). Defaults to BOOKING_OWNER_EMAIL.
UNSUB_NOTIFY_EMAIL=
